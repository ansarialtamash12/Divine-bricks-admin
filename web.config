<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode"/>
    </handlers>

    <iisnode 
      loggingEnabled="true"
      logDirectory="logs"
      devErrorsEnabled="true"
    />

    <rewrite>
      <rules>
        <rule name="NextJsApp">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
